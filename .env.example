# Copiar a .env.local y completar con los datos del proyecto Supabase
# (Project Settings → API). La clave es la "publishable" (o "anon"), nunca la secreta.
EXPO_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
EXPO_PUBLIC_SUPABASE_KEY=sb_publishable_xxxxxxxx

# Opcionales (pantalla Suscripción): contacto y datos para pagar.
EXPO_PUBLIC_CONTACTO_WHATSAPP=+56912345678
EXPO_PUBLIC_CONTACTO_CORREO=contacto@ejemplo.cl
EXPO_PUBLIC_DATOS_TRANSFERENCIA=Banco X, cuenta vista 123456, RUT 11.111.111-1
