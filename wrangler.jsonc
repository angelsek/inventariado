// Versión web (PC) en Cloudflare Workers (proyecto "stockeao-web", conectado a este repositorio).
// Cloudflare compila (expo export + scripts/construir-web.mjs) y publica dist/: solo archivos estáticos, sin
// código de servidor. Las cabeceras (CSP, COOP/COEP…) las pone dist/_headers.
{
  "name": "stockeao-web",
  "compatibility_date": "2026-10-01",
  // Wrangler compila antes de publicar, aunque el proyecto de Cloudflare no tenga comando de
  // build configurado (si lo tiene, se compila dos veces: no es un problema).
  "build": {
    "command": "npx expo export --platform web && node scripts/construir-web.mjs",
  },
  // Vista previa de cada rama que no es main (Cloudflare ejecuta `wrangler preview`): usa la
  // misma configuración de abajo.
  "previews": {},
  "assets": {
    "directory": "./dist/",
    // Cualquier ruta de la app (/vender, /caja…) abre index.html: Expo Router decide la pantalla.
    "not_found_handling": "single-page-application",
    // Sin redirecciones de /index.html a /: el service worker guarda /index.html y una respuesta
    // redirigida no sirve para abrir la app sin internet.
    "html_handling": "none",
  },
}
